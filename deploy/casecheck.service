[Unit]
Description=CaseCheck synthetic AI test panel
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/casecheck
EnvironmentFile=%h/casecheck.env
ExecStart=/usr/bin/node %h/casecheck/src/server.mjs
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
MemoryMax=256M
TasksMax=64

[Install]
WantedBy=default.target
