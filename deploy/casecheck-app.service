[Unit]
Description=CaseCheck intake and document review pilot
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/casecheck
EnvironmentFile=%h/casecheck-app.env
ExecStart=/usr/bin/node %h/casecheck/src/app-server.mjs
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
MemoryMax=512M
TasksMax=96

[Install]
WantedBy=default.target
