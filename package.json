{
  "name": "casecheck-ai-core",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:acceptance": "node scripts/acceptance.mjs --plan",
    "start": "node src/app-server.mjs",
    "ai:check": "node scripts/smoke-ai.mjs --dry-run",
    "ai:smoke": "node scripts/smoke-ai.mjs",
    "ai:bench": "node scripts/quality-bench.mjs --dry-run",
    "ai:bench:extended": "node scripts/extended-bench.mjs --dry-run --hybrid",
    "start:lab": "node src/server.mjs",
    "data:generate": "node scripts/generate-synthetic-cases.mjs",
    "backup": "node scripts/backup.mjs"
  },
  "dependencies": {
    "docx": "9.8.1",
    "pdfjs-dist": "6.3.289",
    "pdfkit": "0.20.2"
  }
}
