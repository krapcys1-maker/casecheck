# Klucze wyłącznie po stronie serwera. Nie zapisuj ich w repozytorium.
DEEPSEEK_API_KEY=

# Jedyny dozwolony model: DeepSeek V4.1 Flash.
DEEPSEEK_MODEL=deepseek-flash

# Panel testów: wygeneruj osobne, długie hasło (minimum 32 znaki).
CASECHECK_ACCESS_TOKEN=
CASECHECK_PORT=8860
CASECHECK_BASE_PATH=/casecheck
CASECHECK_DAILY_REQUEST_LIMIT=20
# Ustaw adres HTTPS przy wdrożeniu za nginx.
CASECHECK_PUBLIC_ORIGIN=

# Pilotaż (npm start). Hasło tworzy pierwsze konto na pustej bazie.
CASECHECK_ADMIN_EMAIL=admin@casecheck.local
CASECHECK_ADMIN_PASSWORD=
CASECHECK_APP_PORT=8861
CASECHECK_APP_BASE_PATH=/casecheck
CASECHECK_APP_STATE_DIR=

# Łączny limit USD na przyszłe wywołania; brak klucza nie wyłącza limitu.
CASECHECK_AI_USD_LIMIT=10
# Wspólna trwała baza kosztów dla wszystkich procesów projektu.
CASECHECK_AI_BUDGET_PATH=
