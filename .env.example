# Klucze wyłącznie po stronie serwera. Nie zapisuj ich w repozytorium.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# Opcjonalne modele do krótkich prób ekstrakcji; bez lokalnego LLM.
OPENAI_MODEL=gpt-4.1-mini-2025-04-14
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
DEEPSEEK_MODEL=deepseek-flash

# Panel testów: wygeneruj osobne, długie hasło (minimum 32 znaki).
CASECHECK_ACCESS_TOKEN=
CASECHECK_PORT=8860
CASECHECK_BASE_PATH=/casecheck
CASECHECK_DAILY_REQUEST_LIMIT=20
# Ustaw adres HTTPS przy wdrożeniu za nginx.
CASECHECK_PUBLIC_ORIGIN=
